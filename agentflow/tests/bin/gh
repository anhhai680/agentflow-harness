#!/usr/bin/env python3
"""A stand-in for `gh` in agentflow tests (tests put this directory first on PATH).

Every call appends its argv as one JSON list to `$FAKE_GH_LOG` (when set). `pr create` prints a PR
URL (`$FAKE_GH_URL`, default https://github.com/example/repo/pull/1); `pr view ... --json state`
prints `{"state": "$FAKE_GH_STATE"}` (default OPEN); `pr view ... --json mergeable,...` plays the next entry of the
comma-separated `$FAKE_GH_MERGEABLE` (the last one repeating; default MERGEABLE; the place is kept in
`$FAKE_GH_LOG.mergeable`); `issue view N ...` prints `$FAKE_GH_ISSUE` (default
an issue titled `Issue N`); `pr checks` plays the next entry of the JSON list in the file `$FAKE_GH_CHECKS`
(`{"checks": [...], "exit": 8, "stderr": "..."}`, the last one repeating; the place is kept in `<file>.cursor`);
anything else prints `$FAKE_GH_JSON` (default `[]`). `$FAKE_GH_FAIL` makes every call fail with exit 1.
`$FAKE_GH_FAIL_ON` is a space-separated argv prefix (`"issue edit"`): a call that starts with it fails with
exit 1, after it is logged. `$FAKE_GH_NO_LABEL` makes the first `issue edit ... --add-label <l>` fail with
"label not found" on stderr (the marker file `$FAKE_GH_LOG.nolabel` makes it fire once). `issue edit`,
`issue comment` and `label create` otherwise print `[]` and exit 0. `pr view ... --json id,closingIssuesReferences`
(or `--json closingIssuesReferences`) prints `{"id": ..., "closingIssuesReferences": [{"number": n}, ...]}`: the id
is `$FAKE_GH_PR_ID` when that is set (even to ""), else `PR_fake`, and the numbers are those in the comma-separated
`$FAKE_GH_CLOSING` plus each line of the file `$FAKE_GH_LOG.closing`. The default `issue view N` reply carries
`"id": "I_fakeN"`. `api graphql` with `addCloseIssueReferences` in its `query=` argument appends the issue's number
(from its `issue=I_fakeN` variable) to `$FAKE_GH_LOG.closing`, unless `$FAKE_GH_LINK_IGNORED` is set, and prints
`{"data": {"addCloseIssueReferences": {"clientMutationId": null}}}`. `issue list` prints `$FAKE_GH_ISSUE_LIST`
(default `[]`).
Two modes for the issue-dependency fields: with `$FAKE_GH_OLD` set (an old `gh`), an `issue list` or `issue view`
whose `--json` value contains `blockedBy` writes `Unknown JSON field: "blockedBy"` to stderr and exits 1, after it is
logged. `issue list --json` as the last argument prints `$FAKE_GH_JSON_FIELDS` (default: the field list of gh 2.103,
one field per line under "Specify one or more comma-separated fields for `--json`:") and exits 0.
"""

import json
import os
import sys

DEFAULT_JSON_FIELDS = "Specify one or more comma-separated fields for `--json`:\n" + "".join(
    f"  {name}\n" for name in (
        "assignees", "author", "blockedBy", "blocking", "body", "closed", "closedAt", "closedByPullRequestsReferences",
        "comments", "createdAt", "id", "isPinned", "labels", "milestone", "number", "projectCards", "projectItems",
        "reactionGroups", "state", "stateReason", "title", "updatedAt", "url"))

args = sys.argv[1:]
log = os.environ.get("FAKE_GH_LOG")
if log:
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(args, ensure_ascii=False) + "\n")
if os.environ.get("FAKE_GH_FAIL"):
    sys.stderr.write("fake gh: failing as asked\n")
    sys.exit(1)
fail_on = os.environ.get("FAKE_GH_FAIL_ON", "").split()
if fail_on and args[: len(fail_on)] == fail_on:
    sys.stderr.write("fake gh: failing as asked\n")
    sys.exit(1)
if args[:1] == ["issue"] and args[1:2] in (["list"], ["view"]) and "--json" in args:
    place = args.index("--json")
    if place == len(args) - 1 and args[1] == "list":
        sys.stdout.write(os.environ.get("FAKE_GH_JSON_FIELDS", DEFAULT_JSON_FIELDS))
        sys.exit(0)
    if os.environ.get("FAKE_GH_OLD") and "blockedBy" in args[place + 1]:
        sys.stderr.write('Unknown JSON field: "blockedBy"\n')
        sys.exit(1)
if os.environ.get("FAKE_GH_NO_LABEL") and args[:2] == ["issue", "edit"] and "--add-label" in args:
    marker = (log or "/tmp/fake_gh") + ".nolabel"
    if not os.path.exists(marker):
        open(marker, "w", encoding="utf-8").close()
        label = args[args.index("--add-label") + 1]
        sys.stderr.write(f"could not add label: '{label}' not found\n")
        sys.exit(1)
if args[:2] == ["pr", "create"]:
    print(os.environ.get("FAKE_GH_URL", "https://github.com/example/repo/pull/1"))
elif args[:2] == ["pr", "checks"] and os.environ.get("FAKE_GH_CHECKS"):
    path = os.environ["FAKE_GH_CHECKS"]
    with open(path, encoding="utf-8") as handle:
        entries = json.load(handle)
    cursor = path + ".cursor"
    place = int(open(cursor, encoding="utf-8").read()) if os.path.exists(cursor) else 0
    with open(cursor, "w", encoding="utf-8") as handle:
        handle.write(str(place + 1))
    entry = entries[min(place, len(entries) - 1)]
    if "checks" in entry:
        print(json.dumps(entry["checks"]))
    if entry.get("stderr"):
        sys.stderr.write(entry["stderr"] + "\n")
    sys.exit(entry.get("exit", 0))
elif args[:2] == ["pr", "view"] and "--json" in args and args[args.index("--json") + 1:][:1] in (
        ["id,closingIssuesReferences"], ["closingIssuesReferences"]):
    numbers = [n for n in os.environ.get("FAKE_GH_CLOSING", "").split(",") if n.strip()]
    closing = (log or "/tmp/fake_gh") + ".closing"
    if os.path.exists(closing):
        numbers += [line for line in open(closing, encoding="utf-8").read().splitlines() if line.strip()]
    pr_id = os.environ["FAKE_GH_PR_ID"] if "FAKE_GH_PR_ID" in os.environ else "PR_fake"
    refs = [{"number": int(n) if n.strip().isdigit() else n.strip()} for n in numbers]
    print(json.dumps({"id": pr_id, "closingIssuesReferences": refs}))
elif args[:2] == ["api", "graphql"]:
    query = next((a[len("query="):] for a in args if a.startswith("query=")), "")
    issue = next((a[len("issue="):] for a in args if a.startswith("issue=")), "")
    if "addCloseIssueReferences" in query and issue.startswith("I_fake") and not os.environ.get("FAKE_GH_LINK_IGNORED"):
        with open((log or "/tmp/fake_gh") + ".closing", "a", encoding="utf-8") as handle:
            handle.write(issue[len("I_fake"):] + "\n")
    print(json.dumps({"data": {"addCloseIssueReferences": {"clientMutationId": None}}}))
elif args[:2] == ["pr", "view"] and "--json" in args and args[args.index("--json") + 1].startswith("mergeable"):
    verdicts = os.environ.get("FAKE_GH_MERGEABLE", "MERGEABLE").split(",")
    cursor = (log or "/tmp/fake_gh") + ".mergeable"
    place = int(open(cursor, encoding="utf-8").read()) if os.path.exists(cursor) else 0
    with open(cursor, "w", encoding="utf-8") as handle:
        handle.write(str(place + 1))
    print(json.dumps({"mergeable": verdicts[min(place, len(verdicts) - 1)], "mergeStateStatus": "CLEAN"}))
elif args[:2] == ["pr", "view"] and "--json" in args and "state" in args[args.index("--json") + 1:][:1]:
    print(json.dumps({"state": os.environ.get("FAKE_GH_STATE", "OPEN")}))
elif args[:2] == ["issue", "list"]:
    print(os.environ.get("FAKE_GH_ISSUE_LIST", "[]"))
elif args[:2] == ["issue", "view"] and len(args) > 2:
    default = {"title": f"Issue {args[2]}", "body": "", "url": f"https://github.com/example/repo/issues/{args[2]}",
               "id": f"I_fake{args[2]}"}
    if "--json" in args and "blockedBy" in args[args.index("--json") + 1]:
        default["blockedBy"] = {"nodes": [], "totalCount": 0}  # the real `gh` prints a field only when asked for it
    print(os.environ.get("FAKE_GH_ISSUE") or json.dumps(default))
else:
    print(os.environ.get("FAKE_GH_JSON", "[]"))
