{
  "enabledPlugins": {},
  "permissions": {
    "allow": [
      "Bash(uv run --no-project --with pyyaml --with pytest pytest *)",
      "Bash(bin/agentflow validate)",
      "Bash(bin/agentflow explain *)",
      "Bash(bin/agentflow next)",
      "Bash(bin/agentflow status *)",
      "Bash(bin/agentflow inbox)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git *--output*)",
      "Bash(uv run git *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.test)"
    ]
  }
}
